<?xml version="1.0"?>
<!--
 Warfork build commands.

 makebsp and makelight are expected in the NetRadiant directory ([RadiantPath]).
 q3map2 is kept only for the minimap build.
-->
<project version="2.0">
<var name="makebsp">&quot;[RadiantPath]makebsp.[ExecutableType]&quot;[ExtraResourcePaths]<cond value="[MonitorAddress]"> -connect [MonitorAddress]</cond> -game warfork -fs_basepath &quot;[EnginePath]&quot;<cond value="[GameName]"> -fs_game [GameName]</cond></var>
<var name="makelight">&quot;[RadiantPath]makelight.[ExecutableType]&quot;[ExtraResourcePaths]<cond value="[MonitorAddress]"> -connect [MonitorAddress]</cond> -game warfork -fs_basepath &quot;[EnginePath]&quot;<cond value="[GameName]"> -fs_game [GameName]</cond></var>
<var name="q3map2">&quot;[RadiantPath]q3map2.[ExecutableType]&quot;[ExtraResourcePaths]<cond value="[MonitorAddress]"> -connect [MonitorAddress]</cond> -game qfusion -fs_basepath &quot;[EnginePath]&quot;<cond value="[GameName]"> -fs_game [GameName]</cond></var>

<build name="Makebsp: Leaktest">
<command>[makebsp] -samplesize 16 -fast -leaktest &quot;[MapFile]&quot;</command>
</build>
<build name="Makebsp: Fast">
<command>[makebsp] -fast -samplesize 8 &quot;[MapFile]&quot;</command>
<command>[makelight] -fast &quot;[MapFile]&quot;</command>
</build>
<build name="Makebsp: Fast Light">
<command>[makebsp] -samplesize 8 &quot;[MapFile]&quot;</command>
<command>[makelight] -fast &quot;[MapFile]&quot;</command>
</build>
<build name="Makebsp: Build (Standard)">
<command>[makebsp] &quot;[MapFile]&quot;</command>
<command>[makelight] &quot;[MapFile]&quot;</command>
</build>
<build name="Makebsp: Upscale">
<command>[makebsp] &quot;[MapFile]&quot;</command>
<command>[makelight] -upscale &quot;[MapFile]&quot;</command>
</build>

<separator />

<build name="Makebsp: Update Entities (requires compiled BSP)">
<command>[makebsp] -onlyents &quot;[MapFile]&quot;</command>
</build>
<build name="Q3Map2: Make Minimap (requires compiled BSP)">
<command>[q3map2] -minimap -size 256 -sharpen 1 -border 0 &quot;[MapFile]&quot;</command>
</build>

<separator />

<build name="Makebsp: Export to OBJ (-map2obj)">
<command>[makebsp] -map2obj &quot;[MapFile]&quot;</command>
</build>
<build name="Makebsp: Export to ASE (-map2ase)">
<command>[makebsp] -map2ase &quot;[MapFile]&quot;</command>
</build>
</project>
