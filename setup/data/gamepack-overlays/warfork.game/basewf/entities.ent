<?xml version="1.0"?>
<!--
 Warfork entity definition file for NetRadiant
 Converted from the legacy entities.def (v1.2, 16/04/2023) to modern .ent XML.
 Entity keys cross-checked against the Warfork source and the makebsp mapper
 documentation; media paths verified against the current basewf packages.
-->
<classes>

<!--
=============================================================================

 WORLDSPAWN ENTITY

=============================================================================
-->

  <group name="worldspawn" color="0 0 0">
The world. All brushes not inside another entity belong to worldspawn.
If you see this, the currently selected brush is not part of an entity.
-------- KEYS --------
<string key="message" name="Message">Text printed at user logon; used as the level name.</string>
<sound key="music" name="Music File">Looping sound file used for level music (eg. music/sonic5.wav).</sound>
<real key="gravity" name="Gravity">Level gravity (default 800).</real>
<texture key="colorCorrection" name="Color Correction LUT">Global color correction LUT for the level.</texture>
-------- LIGHTING KEYS --------
<real key="ambient" name="Ambient Light">Constant macro-ambient occlusion light intensity (default 0). Discouraged: it flattens light/shade variation.</real>
<color key="_color" name="Ambient Color">Global ambient color (default 1 1 1). Legacy unprefixed color is also accepted by makebsp.</color>
<color key="ambient_sky" name="Sky Ambient Color">Sky-facing ambient color; overrides color for upward surfaces.</color>
<string key="shading" name="Angular Shading Model">halflambert (Warfork default), lambert, quadratic, doublequadratic, unreal.</string>
<string key="attenuation" name="Falloff Model">standard (default), soft, linear, unreal, smoothstep.</string>
<string key="exposurefilter" name="Exposure Filter">softknee, reinhard (default), filmic, linear/off.</string>
<real key="saturation" name="Saturation">Global lightmap saturation multiplier (Warfork default 1.5).</real>
<string key="saturationramp" name="Saturation Curve">filmic, power, halfpower, midtone, off.</string>
<real key="cutoff" name="Cutoff Anchor">Auto-scaled cutoff budget for the reference light (profile default 1.0).</real>
<real key="energycutoff" name="Absolute Energy Cutoff">Absolute energy cull threshold (0 = auto-scaling).</real>
<real key="fadeout" name="Fade Out">Fraction of light reach used for a soft fade (profile default 0.05).</real>
<real key="backsplashspot" name="Spot Backsplash">Default spotlight backsplash fraction (0..1).</real>
<real key="backsplashsurface" name="Surface Backsplash">Default surface-light backsplash fraction (0..1).</real>
<texture key="haloshader" name="Default Halo Shader">Default light halo shader (halo); "none" or "0" disables.</texture>
-------- AMBIENT OCCLUSION / LIGHTGRID KEYS --------
<real key="ambient_testradius" name="AO Test Radius">Occlusion test radius in world units (Warfork default 320, min 32).</real>
<real key="ambient_gatheradius" name="AO Gather Radius">Light-probe gather radius (Warfork default 900, min 32).</real>
<real key="ambient_gridscale" name="AO Grid Scale">Multiplier on MAO contribution to the lightgrid (default 1).</real>
<real key="ambient_gridmaxluma" name="AO Grid Max Luma">Per-component luma ceiling on MAO grid contribution (profile default 72, 0 disables).</real>
<real key="grid_smoothambient" name="Ambient Grid Smoothing">Ambient lightgrid smoothing radius (Warfork default 320; 0 disables).</real>
<integer key="grid_smoothambient_passes" name="Ambient Smooth Passes">Ambient grid smoothing passes (Warfork default 4).</integer>
<real key="grid_smoothdirect" name="Direct Grid Smoothing">Direct lightgrid smoothing radius (Warfork default 128).</real>
<integer key="grid_smoothdirect_passes" name="Direct Smooth Passes">Direct grid smoothing passes (Warfork default 3).</integer>
<real key="grid_clamp_minambient" name="Min Ambient Grid Luma">Final ambient grid luma floor, percent of 255 x hdr8BitScale (0 = off).</real>
<real key="grid_clamp_maxambient" name="Max Ambient Grid Luma">Final ambient grid luma ceiling (0 = off).</real>
<real key="grid_clamp_maxdirect" name="Max Direct Grid Luma">Final direct grid luma ceiling (0 = off).</real>
<real key="grid_ambientscale" name="Grid Ambient Scale">Map-wide default per-light grid ambient multiplier (default 1).</real>
<real key="grid_directscale" name="Grid Direct Scale">Map-wide default per-light grid direct multiplier (default 1.75).</real>
<integer3 key="gridsize" name="Lightgrid Size">Lightgrid cell size X Y Z (legacy default 128 128 256). 0 disables the grid.</integer3>
<real key="_lightingIntensity" name="LDR Lighting Intensity">Fixed scale for 8-bit lightmap/grid output (profile default 3.0).</real>
-------- LIGHTMAP KEYS --------
<real key="samplesize" name="Lightmap Sample Size">Global lightmap sample size in game units (profile default 4).</real>
<boolean key="deluxe" name="Deluxe Maps">Generate deluxe/direction maps (on by default for qfusion).</boolean>
<real key="deluxe_minangle" name="Deluxe Min Angle">Deluxe blend minimum angle, 0..90 (profile default 15).</real>
<real key="supersample" name="Supersample Radius">Global supersampling trace radius (0 = off).</real>
<real key="smooth" name="Lightmap Smooth Radius">Global lightmap smoothing radius (default 0.35; 0 disables).</real>
<integer key="smoothpasses" name="Lightmap Smooth Passes">Lightmap smoothing passes (default 4).</integer>
<integer key="antialiasing" name="Antialiasing Passes">Global antialiasing passes (default 0).</integer>
-------- RADIOSITY KEYS --------
<real key="radiosity" name="Bounce Light Intensity">Radiosity bounce intensity (1.0 default; 0 disables).</real>
<real key="rad_color_ratio" name="Bounce Color Ratio">How much texture color tints bounce light (default 1).</real>
<integer key="rad_interval" name="Radiosity Interval">Voxelization interval, power of 2 (default 4).</integer>
<real key="rad_ao_intensity" name="Radiosity AO">Small-scale crease AO strength, 0..1 (profile default 0.5).</real>
<real key="rad_ao_min" name="Radiosity AO Fade Start">AO fade start distance (default 0).</real>
<real key="rad_ao_max" name="Radiosity AO Fade End">AO fade end distance (profile default 24).</real>
<real key="rad_gridscale" name="Bounce Grid Scale">Bounce-light multiplier into the ambient grid (profile default 1.5).</real>
-------- GEOMETRY / BSP KEYS --------
<real key="blocksize" name="BSP Block Size">BSP splitting block size (default 1024). Legacy _blocksize is also accepted.</real>
<boolean key="enforcesamplesize" name="Enforce Sample Size">Force brush subdivision to honour samplesize (on by default).</boolean>
<boolean key="patchtris" name="Patch To Trisoup">Cook all world Bezier patches to triangle soup (CLI -patchtris wins).</boolean>
<real key="chamfer_convexwidth" name="Convex Chamfer Width">Global convex-edge chamfer width (profile default 1.25).</real>
<real key="chamfer_concavewidth" name="Concave Chamfer Width">Global concave-edge chamfer width (default 0).</real>
<real key="trisoup_subdivide" name="Trisoup Subdivide">Fallback patch-flattening tolerance (profile default 6.0).</real>
<real key="areascale" name="Area Light Scale">Map-wide area-light intensity scale (default 1).</real>
<real key="directscale" name="Direct Light Scale">Map-wide direct-light intensity scale (default 1).</real>
<boolean key="castshadows" name="World Shadow Casting">Whether the world casts shadows (default 1). Alias: cs.</boolean>
-------- COMPILER KEYS (informational) --------
<boolean key="_keeplights" name="Keep Light Entities">Keep light entities in the BSP; Warfork needs this set to 1 for realtime lights.</boolean>
<string key="_makebsp_profile" name="makebsp Profile">Injected by makebsp: name of the profile used for this compile.</string>
<string key="_makebsp_version" name="makebsp Version">Injected by makebsp: compiler version string.</string>
-------- NOTES --------
makebsp keys are case-insensitive and ignore a single leading underscore; the profile in makebspdata/warfork.json supplies the defaults listed above. Command-line switches override worldspawn keys.
  </group>


<!--
=============================================================================

 WEAPON_* ENTITIES

=============================================================================
-->

  <point name="weapon_machinegun" color="1 0 .5" box="-16 -16 -16 16 16 48" model="models/weapons/machinegun/machinegun.md3">
Machinegun
-------- KEYS --------
<target key="target" name="Target">activating this entity will trigger any entity with this as targetname.</target>
<targetname key="targetname" name="Target Name">name to use for targeting this entity.</targetname>
<real key="wait" name="Delay">Time in seconds before the item first spawns after map start. Respawn times are controlled by the gametype and cannot be set by the mapper.</real>
<string key="team" name="Team Name">set this to team items. Teamed items will respawn randomly after team master is picked up (see Notes).</string>
<boolean key="notfree" name="Hidden for Solo">Set to 1 to hide this entity in non-team-based gametypes (ffa, dm, duel, race, ...) and in team gametypes limited to one player per team.</boolean>
<boolean key="notduel" name="Hidden for Duels">Set to 1 to hide this entity in team-based gametypes with exactly one player per team.</boolean>
<boolean key="notteam" name="Hidden for Teamplay">Set to 1 to hide this entity in team-based gametypes with more than one player per team (e.g. CTF, TDM).</boolean>
<string key="gametype" name="Supported Game Types">Comma- or space-separated allow-list of gametype names in which this entity will spawn; if set, it will not spawn in any other gametype. Names are case-insensitive. See the supported gametype values note below.</string>
<string key="not_gametype" name="Excluded Game Types">Comma- or space-separated deny-list of gametype names in which this entity must not spawn. Uses the same values as the gametype key.</string>
-------- SPAWNFLAGS --------
<flag key="SUSPENDED" name="Suspended" bit="0">Float: disable gravity and do not drop the item to the floor.</flag>
-------- NOTES --------
In Warfork, the wait key only sets the initial spawn delay; respawn intervals depend on the gametype.
Supported gametype values: Bomb and Defuse: bomb, Clan Arena: ca, Capture the Flag: ctf, Capture the Flag Tactics: ctftactics, Duel Arena: da, Deathmatch: dm, Tournament: duel, Free for All: ffa, Headhunt: headhunt, Race: race, Rekt: rekt, Team Deathmatch: tdm, Tutorial: tutorial.
  </point>

  <point name="weapon_riotgun" color="1 0 .5" box="-16 -16 -16 16 16 48" model="models/weapons/riotgun/riotgun.md3">
Riot Gun
-------- KEYS --------
<target key="target" name="Target">activating this entity will trigger any entity with this as targetname.</target>
<targetname key="targetname" name="Target Name">name to use for targeting this entity.</targetname>
<real key="wait" name="Delay">Time in seconds before the item first spawns after map start. Respawn times are controlled by the gametype and cannot be set by the mapper.</real>
<string key="team" name="Team Name">set this to team items. Teamed items will respawn randomly after team master is picked up (see Notes).</string>
<boolean key="notfree" name="Hidden for Solo">Set to 1 to hide this entity in non-team-based gametypes (ffa, dm, duel, race, ...) and in team gametypes limited to one player per team.</boolean>
<boolean key="notduel" name="Hidden for Duels">Set to 1 to hide this entity in team-based gametypes with exactly one player per team.</boolean>
<boolean key="notteam" name="Hidden for Teamplay">Set to 1 to hide this entity in team-based gametypes with more than one player per team (e.g. CTF, TDM).</boolean>
<string key="gametype" name="Supported Game Types">Comma- or space-separated allow-list of gametype names in which this entity will spawn; if set, it will not spawn in any other gametype. Names are case-insensitive. See the supported gametype values note below.</string>
<string key="not_gametype" name="Excluded Game Types">Comma- or space-separated deny-list of gametype names in which this entity must not spawn. Uses the same values as the gametype key.</string>
-------- SPAWNFLAGS --------
<flag key="SUSPENDED" name="Suspended" bit="0">Float: disable gravity and do not drop the item to the floor.</flag>
-------- NOTES --------
The amount of time it takes for an item in the team to respawn is determined by the "wait" value of the item that was picked up previously. So if one of the items in the team has it's "wait" key set to -1 (never respawn), the random respawning cycle of the teamed items will stop after that item is picked up.
In Warfork, "wait" will be understood only as delay for spawning the item once the map starts. Respawn item times depend on the gametype and can't be selected by the mapper.
Supported gametype values: Bomb and Defuse: bomb, Clan Arena: ca, Capture the Flag: ctf, Capture the Flag Tactics: ctftactics, Duel Arena: da, Deathmatch: dm, Tournament: duel, Free for All: ffa, Headhunt: headhunt, Race: race, Rekt: rekt, Team Deathmatch: tdm, Tutorial: tutorial.
  </point>

